# Copy to .env and fill in.

# --- Required ---
# URL of your Uptime Kuma instance (the compose file defaults to http://kuma:3001)
KUMA_SERVER=
KUMA_USERNAME=
KUMA_PASSWORD=
# Password of the API "admin" user
ADMIN_PASSWORD=

# --- Optional ---
# JWT signing key. When empty, one is generated and stored next to the database.
SECRET_KEY=
# Access token lifetime in minutes (default: 8 days)
ACCESS_TOKEN_EXPIRATION=11520
# Seconds to wait for Uptime Kuma to answer
# KUMA_TIMEOUT=10
# Set to false to accept a self-signed Uptime Kuma certificate
# KUMA_SSL_VERIFY=true
# JSON list of origins allowed by CORS
# BACKEND_CORS_ORIGINS=["https://dashboard.example.com"]
# LOG_LEVEL=INFO
